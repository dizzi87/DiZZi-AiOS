{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dizzi.local/contracts/task-result/v0",
  "title": "Dizzi portable task/result v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "request", "actual", "timestamps", "status", "result", "error", "tool_events", "approval_events", "usage", "runtime_metadata"],
  "properties": {
    "contract_version": { "const": "0" },
    "task_id": { "$ref": "#/$defs/nonempty" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "worker_id", "runtime", "model", "reasoning_profile", "allowed_tools", "approval_scope", "limits"],
      "properties": {
        "instruction": { "$ref": "#/$defs/nonempty" },
        "worker_id": { "$ref": "#/$defs/nonempty" },
        "runtime": { "$ref": "#/$defs/nonempty" },
        "model": { "$ref": "#/$defs/model" },
        "reasoning_profile": { "$ref": "#/$defs/nonempty" },
        "allowed_tools": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
        "approval_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "actions"],
          "properties": {
            "mode": { "enum": ["deny", "ask", "preapproved"] },
            "actions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_duration_seconds", "max_tool_calls", "max_input_tokens", "max_output_tokens"],
          "properties": {
            "max_duration_seconds": { "$ref": "#/$defs/positive" },
            "max_tool_calls": { "$ref": "#/$defs/nonnegative" },
            "max_input_tokens": { "$ref": "#/$defs/nullable_positive" },
            "max_output_tokens": { "$ref": "#/$defs/nullable_positive" }
          }
        }
      }
    },
    "actual": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["worker_id", "runtime", "model", "reasoning_profile"],
      "properties": {
        "worker_id": { "$ref": "#/$defs/nonempty" },
        "runtime": { "$ref": "#/$defs/nonempty" },
        "model": { "anyOf": [{ "$ref": "#/$defs/model" }, { "type": "null" }] },
        "reasoning_profile": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "started_at", "ended_at"],
      "properties": {
        "created_at": { "$ref": "#/$defs/time" },
        "started_at": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
        "ended_at": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }
      }
    },
    "status": { "enum": ["pending", "running", "completed", "failed", "cancelled"] },
    "result": { "type": ["string", "null"] },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/nonempty" },
        "message": { "$ref": "#/$defs/nonempty" }
      }
    },
    "tool_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "started_at", "ended_at", "duration_ms", "result", "error"],
        "properties": {
          "tool": { "$ref": "#/$defs/nonempty" },
          "started_at": { "$ref": "#/$defs/time" },
          "ended_at": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
          "duration_ms": { "anyOf": [{ "$ref": "#/$defs/nonnegative" }, { "type": "null" }] },
          "result": { "type": ["string", "null"] },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "approval_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "decision", "actor_id", "at"],
        "properties": {
          "action": { "$ref": "#/$defs/nonempty" },
          "decision": { "enum": ["requested", "approved", "denied", "expired"] },
          "actor_id": { "anyOf": [{ "$ref": "#/$defs/nonempty" }, { "type": "null" }] },
          "at": { "$ref": "#/$defs/time" }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens", "context_tokens"],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/nullable_nonnegative" },
        "output_tokens": { "$ref": "#/$defs/nullable_nonnegative" },
        "cache_read_tokens": { "$ref": "#/$defs/nullable_nonnegative" },
        "cache_write_tokens": { "$ref": "#/$defs/nullable_nonnegative" },
        "reasoning_tokens": { "$ref": "#/$defs/nullable_nonnegative" },
        "context_tokens": { "$ref": "#/$defs/nullable_nonnegative" }
      }
    },
    "runtime_metadata": { "type": "object", "description": "Opaque, non-authoritative runtime data; vendor IDs belong only here." }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": { "provider": { "$ref": "#/$defs/nonempty" }, "id": { "$ref": "#/$defs/nonempty" } }
    },
    "nonnegative": { "type": "integer", "minimum": 0 },
    "positive": { "type": "integer", "minimum": 1 },
    "nullable_nonnegative": { "anyOf": [{ "$ref": "#/$defs/nonnegative" }, { "type": "null" }] },
    "nullable_positive": { "anyOf": [{ "$ref": "#/$defs/positive" }, { "type": "null" }] }
  }
}
